PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=cranzo_db
DB_DIALECT=postgres

# JWT Configuration
JWT_ACCESS_SECRET=cranzo_super_secret_access_jwt_key_2026_heavy_telemetry
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=cranzo_super_secret_refresh_jwt_key_2026_heavy_telemetry
JWT_REFRESH_EXPIRES_IN=30d
JWT_SECRET=cranzo_super_secret_jwt_key_2026_heavy_telemetry
JWT_EXPIRES_IN=7d

# Super Admin Seed Credentials
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@cranezo.com
SUPER_ADMIN_PASSWORD=Admin@12345
SUPER_ADMIN_PHONE=+919876543210

# Default Swagger Access Token
DEFAULT_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjAwMDAwMDAwLTAwMDAtMDAwMC0wMDAwLTAwMDAwMDAwMDAwMSIsImVtYWlsIjoic3VwZXJhZG1pbkBjcmFuem8uY29tIiwicm9sZSI6IlNVUEVSX0FETUlOIiwiaWF0IjoxNzkyOTAwMzc4LCJleHAiOjE3OTM1MDUxNzh9.QAudLxQipFiNXN7f6lPFs_37EvXQbNYuvvaAbCZoSyg

# Default OTP for Testing
DEFAULT_OTP=123456

# Push notifications (Firebase Cloud Messaging)
# Firebase console > Project settings > Service accounts > Generate new private key. Keep the file out of git.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# The file goes in the backend folder (next to server.js), never in src/public (that folder is public).
# Hosts that only take env vars: put the whole json (or its base64) here instead of the path.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Test: npm run push:test -- <mobile number or member id>

# Razorpay: Key ID is sent to the app, the secret stays on the server only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# true lets the app use a test "Pay" button when no Razorpay keys are set (never in production)
PAYMENT_TEST_MODE=

# Login OTP by SMS (Twilio Verify): Twilio console > Verify > Services > create one (name it Cranezo) > Service SID (starts with VA)
# Leave empty to use the fixed test code (123456), which is blocked when NODE_ENV=production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Keep the fixed login code (DEFAULT_OTP) and skip Twilio. Remove this line (or set false) once Twilio is approved.
OTP_STATIC=true

# WhatsApp copies of every app notification (Twilio WhatsApp sender + one Meta-approved utility template).
# Off until WHATSAPP_FROM (or WHATSAPP_MESSAGING_SERVICE_SID) and WHATSAPP_TEMPLATE_SID are set. See src/services/whatsapp.service.js
WHATSAPP_FROM=
WHATSAPP_MESSAGING_SERVICE_SID=
WHATSAPP_TEMPLATE_SID=
WHATSAPP_TEMPLATE_SID_HI=
WHATSAPP_TEMPLATE_SID_TE=
# only these types (comma list); empty = every notification except announcements
WHATSAPP_TYPES=

# Operator must reach the site before "arrived" works . false (default): no restriction.
ARRIVAL_CHECK_REQUIRED=false


# Crane tracking and routes
# a crane's average road speed, used for every "arrives in" time (km/h)
CRANE_SPEED_KMPH=25
# optional, free key from openrouteservice.org: routes for heavy vehicles (avoids roads too narrow / low / weak for a crane).
# Without it the free OSRM router is used and the route with the most main road (NH / SH / highway) is picked.
ORS_API_KEY=
# crane size used by the heavy-vehicle route (only with ORS_API_KEY)
CRANE_HEIGHT_M=4
CRANE_WIDTH_M=2.6
CRANE_LENGTH_M=12
CRANE_WEIGHT_T=30
# work beyond the booked hours is charged at the booking's hourly rate after this many minutes (in 30-minute steps)
OVERTIME_GRACE_MINUTES=10
